import json
from pathlib import Path

import torch
import torch.nn as nn
from torch.cuda.amp import autocast, GradScaler

from engine.losses import BCEDiceLoss, BoundaryLoss
from engine.eval import evaluate
from models.CS2 import build_model


def set_seed(seed=42):
    import random
    import numpy as np

    random.seed(seed)
    np.random.seed(seed)

    torch.manual_seed(seed)
    torch.cuda.manual_seed_all(seed)

    torch.backends.cudnn.deterministic = False
    torch.backends.cudnn.benchmark = True


def save_checkpoint(state, filename):
    dir_name = os.path.dirname(filename)

    if dir_name:
        os.makedirs(
            dir_name,
            exist_ok=True
        )

    torch.save(
        state,
        filename
    )


def create_empty_history():
    """
    history 中每个列表的第 i 个元素对应第 i + 1 个 epoch。
    """
    return {
        "epoch": [],
        "train_loss": [],
        "val_dice": [],
        "val_iou": [],
        "val_miou": [],
        "val_precision": [],
        "val_recall": [],
        "val_f1": [],
        "lr": [],
        "best_threshold": [],
        "best_score_so_far": [],
        "best_threshold_so_far": [],
    }


def normalize_history(history):
    """
    兼容旧 checkpoint 中没有新增字段的 history。
    """
    default_history = create_empty_history()

    if not isinstance(history, dict):
        return default_history

    for key in default_history:
        value = history.get(key)

        if isinstance(value, list):
            default_history[key] = value

    return default_history


def save_history(history, save_dir):
    """
    每个 epoch 保存一次 history.json。
    使用临时文件，避免写入过程中程序中断导致 JSON 损坏。
    """
    os.makedirs(
        save_dir,
        exist_ok=True
    )

    history_path = os.path.join(
        save_dir,
        "history.json"
    )

    temp_path = history_path + ".tmp"

    with open(
        temp_path,
        "w",
        encoding="utf-8"
    ) as f:
        json.dump(
            history,
            f,
            indent=2,
            ensure_ascii=False
        )

    os.replace(
        temp_path,
        history_path
    )


def load_checkpoint(
    model,
    optimizer=None,
    scheduler=None,
    scaler=None,
    ckpt_path=None,
    device="cpu"
):
    if (
        ckpt_path is None
        or not Path(ckpt_path).exists()
    ):
        print(
            f"[INFO] No checkpoint loaded: "
            f"{ckpt_path}"
        )

        return {
            "start_epoch": 0,
            "best_score": 0.0,
            "best_threshold": None,
            "best_val_metrics": {},
            "history": create_empty_history(),
        }

    ckpt = torch.load(
        ckpt_path,
        map_location=device
    )

    state_dict = ckpt.get(
        "model",
        ckpt
    )

    new_state_dict = {}

    for key, value in state_dict.items():
        if key.startswith("module."):
            key = key[7:]

        new_state_dict[key] = value

    model.load_state_dict(
        new_state_dict,
        strict=True
    )

    start_epoch = int(
        ckpt.get(
            "epoch",
            0
        )
    )

    best_score = float(
        ckpt.get(
            "best_score",
            0.0
        )
    )

    best_threshold = ckpt.get(
        "best_threshold",
        None
    )

    if best_threshold is not None:
        best_threshold = float(
            best_threshold
        )

    best_val_metrics = ckpt.get(
        "best_val_metrics",
        {}
    )

    history = normalize_history(
        ckpt.get(
            "history",
            None
        )
    )

    if (
        optimizer is not None
        and "optimizer" in ckpt
        and ckpt["optimizer"] is not None
    ):
        try:
            optimizer.load_state_dict(
                ckpt["optimizer"]
            )
        except Exception as e:
            print(
                f"[Warning] optimizer load failed: "
                f"{e}"
            )

    if (
        scheduler is not None
        and "scheduler" in ckpt
        and ckpt["scheduler"] is not None
    ):
        try:
            scheduler.load_state_dict(
                ckpt["scheduler"]
            )
        except Exception as e:
            print(
                f"[Warning] scheduler load failed: "
                f"{e}"
            )

    if (
        scaler is not None
        and "scaler" in ckpt
        and ckpt["scaler"] is not None
    ):
        try:
            scaler.load_state_dict(
                ckpt["scaler"]
            )
        except Exception as e:
            print(
                f"[Warning] scaler load failed: "
                f"{e}"
            )

    print(
        f"[INFO] Loaded checkpoint from "
        f"{ckpt_path}, "
        f"epoch={start_epoch}, "
        f"best_score={best_score:.4f}"
    )

    return {
        "start_epoch": start_epoch,
        "best_score": best_score,
        "best_threshold": best_threshold,
        "best_val_metrics": best_val_metrics,
        "history": history,
    }


def train_one_epoch(
    model,
    dataloader,
    optimizer,
    scaler,
    device="cuda",
    criterion=None,
    boundary_criterion=None,
    boundary_weight=0.0,
    grad_clip=1.0,
    log_interval=50,
):
    model.train()

    running_loss = 0.0
    n = 0

    if criterion is None:
        criterion = BCEDiceLoss()

    for step, batch in enumerate(dataloader):
        if isinstance(batch, dict):
            images = batch["image"]
            masks = batch["mask"]
        else:
            images, masks = batch

        images = images.to(
            device,
            non_blocking=True
        )

        masks = masks.to(
            device,
            non_blocking=True
        )

        optimizer.zero_grad(
            set_to_none=True
        )

        with autocast(
            enabled=device.startswith("cuda")
        ):
            logits = model(images)

            loss = criterion(
                logits,
                masks
            )

            if (
                boundary_criterion is not None
                and boundary_weight > 0
            ):
                boundary_loss = boundary_criterion(
                    logits,
                    masks
                )

                loss = (
                    loss
                    + boundary_weight * boundary_loss
                )

        scaler.scale(loss).backward()

        if (
            grad_clip is not None
            and grad_clip > 0
        ):
            scaler.unscale_(
                optimizer
            )

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                grad_clip
            )

        scaler.step(
            optimizer
        )

        scaler.update()

        running_loss += float(
            loss.item()
        )

        n += 1

        if (
            step + 1
        ) % log_interval == 0:
            print(
                f"  step [{step + 1}/"
                f"{len(dataloader)}] "
                f"loss: {running_loss / n:.4f}"
            )

    return running_loss / max(n, 1)


def _make_checkpoint_state(
    model,
    optimizer,
    scheduler,
    scaler,
    epoch,
    best_score,
    best_threshold,
    best_val_metrics,
    history,
):
    return {
        "epoch": int(epoch),
        "model": model.state_dict(),
        "optimizer": optimizer.state_dict(),
        "scheduler": (
            scheduler.state_dict()
            if scheduler is not None
            else None
        ),
        "scaler": scaler.state_dict(),
        "best_score": float(best_score),
        "best_threshold": float(best_threshold),
        "best_val_metrics": best_val_metrics,
        "history": history,
    }


def train_model(
    model,
    train_loader,
    val_loader,
    epochs=100,
    device="cuda",
    lr=1e-4,
    weight_decay=1e-4,
    save_dir="runs/exp1",
    resume=None,
    criterion=None,
    use_boundary_loss=False,
    boundary_weight=0.0,
    grad_clip=1.0,
    log_interval=50,
    scheduler=None,
    threshold=0.5,
    optimizer=None,
):
    os.makedirs(
        save_dir,
        exist_ok=True
    )

    device = torch.device(
        device
        if torch.cuda.is_available()
        or device == "cpu"
        else "cpu"
    )

    model = model.to(device)

    # 如果外部没有传入 optimizer，才在这里创建。
    # 你的自定义 optimizer 会通过参数传入并实际用于训练。
    if optimizer is None:
        optimizer = torch.optim.AdamW(
            model.parameters(),
            lr=lr,
            weight_decay=weight_decay
        )

    if scheduler is None:
        # 默认 PolyLR
        scheduler = torch.optim.lr_scheduler.LambdaLR(
            optimizer,
            lr_lambda=lambda epoch: (
                1 - epoch / epochs
            ) ** 0.9
        )

    scaler = GradScaler(
        enabled=device.type == "cuda"
    )

    if criterion is None:
        criterion = BCEDiceLoss()

    boundary_criterion = (
        BoundaryLoss(weight=1.0)
        if use_boundary_loss
        else None
    )

    start_epoch = 0
    best_score = 0.0
    best_threshold = float(threshold)
    best_val_metrics = {}
    history = create_empty_history()

    if resume is not None:
        resume_state = load_checkpoint(
            model=model,
            optimizer=optimizer,
            scheduler=scheduler,
            scaler=scaler,
            ckpt_path=resume,
            device="cpu"
        )

        start_epoch = resume_state[
            "start_epoch"
        ]

        best_score = resume_state[
            "best_score"
        ]

        if resume_state["best_threshold"] is not None:
            best_threshold = float(
                resume_state["best_threshold"]
            )

        best_val_metrics = resume_state[
            "best_val_metrics"
        ]

        history = normalize_history(
            resume_state["history"]
        )

        print(
            f"[INFO] Resumed history records: "
            f"{len(history['epoch'])} epochs"
        )

    print(
        "[INFO] Start training..."
    )

    for epoch in range(
        start_epoch,
        epochs
    ):
        t0 = time.time()

        current_lr = float(
            optimizer.param_groups[0]["lr"]
        )

        print(
            f"\nEpoch [{epoch + 1}/{epochs}] "
            f"lr={current_lr:.6e}"
        )

        train_loss = train_one_epoch(
            model=model,
            dataloader=train_loader,
            optimizer=optimizer,
            scaler=scaler,
            device=str(device),
            criterion=criterion,
            boundary_criterion=boundary_criterion,
            boundary_weight=boundary_weight,
            grad_clip=grad_clip,
            log_interval=log_interval,
        )

        val_metrics = evaluate(
            model=model,
            dataloader=val_loader,
            device=str(device),
            threshold=threshold
        )

        scheduler.step()

        elapsed = time.time() - t0

        val_dice = float(
            val_metrics.get(
                "dice",
                0.0
            )
        )

        val_iou = float(
            val_metrics.get(
                "iou",
                0.0
            )
        )

        val_miou = float(
            val_metrics.get(
                "miou",
                0.0
            )
        )

        val_precision = float(
            val_metrics.get(
                "precision",
                0.0
            )
        )

        val_recall = float(
            val_metrics.get(
                "recall",
                0.0
            )
        )

        val_f1 = float(
            val_metrics.get(
                "f1",
                0.0
            )
        )

        cur_best_th = float(
            val_metrics.get(
                "best_threshold",
                threshold
            )
        )

        is_best = val_dice > best_score

        if is_best:
            best_score = val_dice
            best_threshold = cur_best_th
            best_val_metrics = dict(
                val_metrics
            )

        # 记录当前 epoch 的完整数据
        history["epoch"].append(
            epoch + 1
        )

        history["train_loss"].append(
            float(train_loss)
        )

        history["val_dice"].append(
            val_dice
        )

        history["val_iou"].append(
            val_iou
        )

        history["val_miou"].append(
            val_miou
        )

        history["val_precision"].append(
            val_precision
        )

        history["val_recall"].append(
            val_recall
        )

        history["val_f1"].append(
            val_f1
        )

        history["lr"].append(
            current_lr
        )

        # 当前 epoch 搜索出来的最佳阈值
        history["best_threshold"].append(
            cur_best_th
        )

        # 截至当前 epoch 的历史最佳 Dice
        history["best_score_so_far"].append(
            float(best_score)
        )

        # 截至当前 epoch 的历史最佳模型对应阈值
        history["best_threshold_so_far"].append(
            float(best_threshold)
        )

        print(
            f"[Epoch {epoch + 1}] "
            f"train_loss={train_loss:.4f} | "
            f"val_dice={val_dice:.4f} | "
            f"val_iou={val_iou:.4f} | "
            f"val_miou={val_miou:.4f} | "
            f"val_p={val_precision:.4f} | "
            f"val_r={val_recall:.4f} | "
            f"val_f1={val_f1:.4f} | "
            f"best_th={cur_best_th:.2f} | "
            f"time={elapsed:.1f}s"
        )

        if is_best:
            best_path = os.path.join(
                save_dir,
                "best.pth"
            )

            best_state = _make_checkpoint_state(
                model=model,
                optimizer=optimizer,
                scheduler=scheduler,
                scaler=scaler,
                epoch=epoch + 1,
                best_score=best_score,
                best_threshold=best_threshold,
                best_val_metrics=best_val_metrics,
                history=history,
            )

            save_checkpoint(
                best_state,
                best_path
            )

            print(
                f"[INFO] Saved best checkpoint to "
                f"{best_path}"
            )

        last_path = os.path.join(
            save_dir,
            "last.pth"
        )

        last_state = _make_checkpoint_state(
            model=model,
            optimizer=optimizer,
            scheduler=scheduler,
            scaler=scaler,
            epoch=epoch + 1,
            best_score=best_score,
            best_threshold=best_threshold,
            best_val_metrics=best_val_metrics,
            history=history,
        )

        save_checkpoint(
            last_state,
            last_path
        )

        # 每个 epoch 保存一次，便于中断后保留全部记录
        save_history(
            history=history,
            save_dir=save_dir
        )

    # 训练正常结束后再次保存完整 history
    save_history(
        history=history,
        save_dir=save_dir
    )

    history_path = os.path.join(
        save_dir,
        "history.json"
    )

    print(
        f"[INFO] Training finished. "
        f"Best Dice = {best_score:.4f}"
    )

    print(
        f"[INFO] Best threshold = "
        f"{best_threshold:.4f}"
    )

    print(
        f"[INFO] History saved to "
        f"{history_path}"
    )

    return history


